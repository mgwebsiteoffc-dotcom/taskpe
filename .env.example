APP_NAME="TaskPe"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://app.yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Database — MySQL on your shared hosting (cPanel → MySQL Databases)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_taskpe
DB_USERNAME=cpaneluser_taskpe
DB_PASSWORD=change-me

# Database-backed drivers so nothing extra (Redis/supervisor) is needed on
# shared hosting. A single cron entry runs the scheduler every minute; the
# scheduler processes queued WhatsApp jobs and the daily digest.
SESSION_DRIVER=file
CACHE_STORE=database
QUEUE_CONNECTION=database

# ---------------------------------------------------------------------------
# Shopify — copy from Partner Dashboard → your app → Client credentials
# ---------------------------------------------------------------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SCOPES=read_orders,read_products,read_customers,read_content
# Read orders created BEFORE the app was installed. Shopify only grants this after
# Partner Dashboard -> your app -> API access -> Protected customer data approves it,
# and asking for the scope before that approval breaks the install screen for every
# store. So: get the approval first, then flip this to true, run
# `php artisan config:clear`, and have each store reinstall the app. Until then the
# order search is bounded to post-install orders and says so in the picker.
SHOPIFY_READ_ALL_ORDERS=false

# Expiring offline access tokens (required for public apps: the Admin API rejects the
# non-expiring kind). Nothing to opt into — the app asks for the expiring pair at OAuth and
# renews it itself. These only tune how early it renews and how long it waits before it
# retries converting a store left on an old token. Leave them alone unless logs say why.
SHOPIFY_TOKEN_REFRESH_SKEW=120
SHOPIFY_TOKEN_MIGRATE_RETRY=3600

# Who owns the plan prices, and it is a real switch, not a label: the two roads
# are exclusive, and picking the wrong one is the whole failure.
#
#   api      (shipped default) — this app creates the subscription itself with
#            appSubscriptionCreate from the prices in config/shopify.php, and the
#            merchant approves on Shopify's own confirmation page. Nothing has to
#            be configured in the Partner Dashboard beyond the scopes, which is why
#            this is the default: Shopify's hosted plan page only exists once App
#            Pricing has plans in it, and a link to it 404s until then. The plan
#            state is re-read from the store on the board load when the cached read
#            is older than 30 minutes, and after every approval, so a cancellation
#            made on Shopify's billing screen shows up here without a ticket.
#   shopify — Shopify App Pricing: the Dashboard owns the plans and prices them per
#            billing currency, and this app must NOT call the Billing API (Shopify
#            refuses an app-created charge for an app priced that way). Switch to it
#            when the plans exist in the Dashboard; the same Plan tab then links
#            there instead of creating a charge.
#
# `php artisan taskpe:plans` prints the mode next to what each button opens, so a
# mismatch between this line and the Dashboard is visible from one command.
SHOPIFY_BILLING_MODE=api

# The currency an app-created charge is priced in. Shopify documents exactly one
# permitted code for AppRecurringPricingInput.price — USD — whatever currency the
# store is billed in, so a price table that offers only INR can name a plan but
# cannot bill it. A non-USD store sees the USD figure on the card plus Shopify's own
# conversion on the invoice, and the Plan tab says so out loud. Leave this alone.
SHOPIFY_BILLING_CURRENCY=USD

# The handle Shopify hosts your plan-selection page under. (Only read in `shopify`
# mode: with `SHOPIFY_BILLING_MODE=api` the app creates the charge itself and no
# hosted plan page is involved.)
# You do not strictly need to set this any more: the app asks Shopify for its own handle
# (`currentAppInstallation.app.handle`) when a Plan tab is opened with an unconfirmed link, caches it
# per store, and prefers that answer. This value is the fallback for the first load, and the one to
# fix if `php artisan taskpe:plans --links --verify` says the two disagree.
#   https://admin.shopify.com/store/<store>/charges/<THIS>/pricing_plans
# Copy it from Partner Dashboard -> your app -> Settings -> General -> App handle (the same
# string as `handle` in shopify.app.toml). Without it the Plan tab cannot link to Shopify's page
# and merchants have to find it by menu, which is what requirement 1.2.3 rejects.
SHOPIFY_APP_HANDLE=
# Optional: where a merchant picks a plan (your Shopify App Store listing, e.g.
# https://apps.shopify.com/your-app). When empty the app explains the admin path
# instead of showing a button that might go nowhere.
SHOPIFY_APP_PLANS_URL=

# Optional, and only for skipping one step. With Shopify App Pricing (`shopify` mode) the in-app
# switcher can open THAT plan's approval page instead of the plan list, which
# needs the plan's own handle. The app learns them by itself — Shopify appends
# ?plan_handle= to the return redirect after any plan change, and the app saves
# it per store — so these are only worth setting for a store that has never
# switched yet. Copy each from Partner Dashboard → your app → App pricing (the
# string in that plan's redirect / plan URL). Wrong value = Shopify's 404 page,
# so leave empty when unsure: the plan list is always right.
TASKPE_PLAN_STARTER_HANDLE=
TASKPE_PLAN_GROWTH_HANDLE=

# Only if Shopify answers a correct plan link with its Apps list: build the same link through the
# store's own domain instead of admin.shopify.com/store/{slug}, so nothing depends on the store slug
# (renamed and transferred stores can differ from the myshopify prefix). `php artisan taskpe:plans
# --links` prints both forms and says which one is in use.
SHOPIFY_PLANS_URL_STYLE=admin

# The one other answer to a correct-looking link is Shopify's "There's no page at this address":
# then the handle is right and the Dashboard has nothing to show — App Pricing is switched off or
# no plan has been created. Nothing in this file fixes that; `php artisan taskpe:plans` prints the
# same diagnosis with the two Dashboard checks to make.

# Test charges — the only charge-related switch in this app, and it never affects Shopify's own
# plan pages. Leave the line out (as here) for production: the app then asks Shopify per store
# whether it is a development store (shop.plan.partnerDevelopment), so a demo store can approve a
# plan change without paying while a real merchant is always billed for real. Setting it to true
# makes EVERY charge this app creates a test charge: the store reads "subscribed", you see no
# revenue. Rehearse a plan change with it, then remove the line.
# SHOPIFY_BILLING_TEST=true

# ---------------------------------------------------------------------------
# Whatify (BYO-BSP WhatsApp) — merchants paste their own key inside the app;
# these are only defaults/overrides for the integration wiring.
# ---------------------------------------------------------------------------
WHATIFY_BASE_URL=https://whatify.in/api/v1/external
WHATIFY_TIMEOUT=15
WHATIFY_DEFAULT_COUNTRY_CODE=91
